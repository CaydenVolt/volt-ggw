---
/**
 * The document shell for every page: <head>, nav, page content, footer.
 *
 * Three jobs worth knowing about:
 *
 *  1. It emits the brand colour palette from `client.ts` as CSS custom
 *     properties on `:root`. `global.css` maps those onto Tailwind utility
 *     names, so changing a hex in the config re-skins the entire site.
 *
 *  2. It resolves per-page SEO. Pass `pageKey` to pull a title/description
 *     from `seo.pages`, or pass `title`/`description` directly to override.
 *     Anything missing falls back to the site-wide `seo` defaults.
 *
 *  3. It holds the commented-out slots for GA4 / Meta Pixel / Google Ads.
 *     Per the brief these are NOT injected yet, only the IDs are wired up.
 */
import '../styles/global.css';
import client, { siteUrl, isPreview } from '../config/client.ts';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  /** Key into `seo.pages`. Ignored if `title`/`description` are passed. */
  pageKey?: string;
  /** Explicit override, wins over `pageKey`. Used by dynamic routes. */
  title?: string;
  description?: string;
  /** Social share image path, overriding `seo.ogImage`. */
  ogImage?: string;
  /** Set true on pages that should stay out of search results. */
  noindex?: boolean;
}

const {
  pageKey,
  title: titleProp,
  description: descriptionProp,
  ogImage: ogImageProp,
  noindex = false,
} = Astro.props;

const { brand, siteVerification, seo } = client;

/* Explicit prop → page config → site default. */
const pageMeta = pageKey ? (seo.pages as Record<string, { title?: string; description?: string }>)[pageKey] : undefined;
const title = titleProp ?? pageMeta?.title ?? seo.title;
const description = descriptionProp ?? pageMeta?.description ?? seo.description;

const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(ogImageProp ?? seo.ogImage, siteUrl).href;

/*
 * A preview build is noindex everywhere, regardless of what a page asked for.
 * The per-page `noindex` prop can only ever add the tag, never remove it.
 */
const blockIndexing = isPreview || noindex;


/*
 * Palette → CSS custom properties. This is the single bridge between the
 * TypeScript config and the stylesheet.
 */
const brandVars = [
  `--brand-primary:${brand.primary}`,
  `--brand-primary-light:${brand.primaryLight}`,
  `--brand-secondary:${brand.secondary}`,
  `--brand-accent:${brand.accent}`,
  `--brand-accent-hover:${brand.accentHover}`,
  `--brand-accent-text:${brand.accentText}`,
  `--brand-accent-deep:${brand.accentDeep}`,
  `--brand-bg:${brand.background}`,
  `--brand-bg-alt:${brand.backgroundAlt}`,
  `--brand-text:${brand.text}`,
  `--brand-muted:${brand.textMuted}`,
].join(';');
---

<!doctype html>
<html lang="en-SG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      blockIndexing && (
        <meta
          name="robots"
          content={isPreview ? 'noindex, nofollow' : 'noindex, follow'}
        />
      )
    }

    {/*
      Favicons: SVG for modern browsers (crisp on Retina), PNG fallbacks for
      the rest, apple-touch-icon for iOS home-screen, .ico at root for
      legacy browsers and bots that hardcode the path.
    */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={brand.primary} />

    {/*
      Google Search Console verification. Add this domain as a property in
      GSC, pick the "HTML tag" verification method, and paste the token into
      `siteVerification.google` in the config. Empty = no tag rendered.
    */}
    {
      siteVerification.google && (
        <meta name="google-site-verification" content={siteVerification.google} />
      )
    }

    {/* Open Graph / social preview */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={client.company.name} />
    <meta property="og:locale" content={seo.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Inter, the only external asset the page loads. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />

    {/* Brand palette from src/config/client.ts */}
    <style is:inline set:html={`:root{${brandVars}}`}></style>

    <slot name="head" />
  </head>

  <body class="flex min-h-screen flex-col bg-brand-bg text-brand-text antialiased">
    {/* Keyboard users land here first. */}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-brand-accent focus:px-4 focus:py-2 focus:font-semibold focus:text-brand-accent-text"
    >
      Skip to content
    </a>

    <Nav />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
