---
/**
 * Shared shell for the compliance pages (/privacy, /terms).
 *
 * Content is passed as a slot and styled by the scoped block at the bottom,
 * so the page files stay as plain readable prose.
 */
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import client from '../config/client.ts';

export interface Props {
  title: string;
  /** Short line under the H1. */
  intro?: string;
}

const { title, intro } = Astro.props;
const { company, legal } = client;
---

<BaseLayout
  title={`${title} | ${company.name}`}
  description={`${title} for ${company.legalName}.`}
  noindex={true}
>
  <Nav />

  <main id="main">
    {/* ── Page header ── */}
    <header class="bg-brand-primary py-14 md:py-20">
      <div class="container-x">
        <div class="mx-auto max-w-3xl">
          <a
            href="/"
            class="text-sm font-semibold text-brand-accent transition-colors hover:text-white"
          >
            ← Back to home
          </a>
          <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
            {title}
          </h1>
          {intro && <p class="mt-4 text-lg leading-relaxed text-white/70">{intro}</p>}
          <p class="mt-4 text-sm text-white/50">
            Last updated: {legal.lastUpdated}
          </p>
        </div>
      </div>
    </header>

    {/* ── Body ── */}
    <div class="section-y bg-white">
      <div class="container-x">
        <div class="legal-prose mx-auto max-w-3xl">
          {/*
            PLACEHOLDER LEGAL TEXT — see the notice rendered on each page.
            This is scaffolding, not legal advice.
          */}
          <slot />
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  /*
   * Minimal prose styling. Scoped to this layout so it cannot leak into the
   * marketing sections, which are styled entirely with utilities.
   * `:global` is required because the content arrives through <slot />.
   */
  .legal-prose :global(h2) {
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.3;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .legal-prose :global(h2:first-child) {
    margin-top: 0;
  }

  .legal-prose :global(h3) {
    font-size: 1.0625rem;
    font-weight: 700;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .legal-prose :global(p) {
    margin-bottom: 1rem;
    line-height: 1.7;
    color: var(--color-brand-muted);
  }

  .legal-prose :global(ul) {
    margin: 0 0 1rem 0;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .legal-prose :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.7;
    color: var(--color-brand-muted);
  }

  .legal-prose :global(a) {
    color: var(--color-brand-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal-prose :global(a:hover) {
    color: var(--color-brand-accent-hover);
  }

  .legal-prose :global(strong) {
    color: var(--color-brand-text);
    font-weight: 700;
  }

  /* The "replace this before launch" callout. */
  .legal-prose :global(.legal-notice) {
    margin-bottom: 2.5rem;
    border-left: 4px solid var(--color-brand-accent);
    background: var(--color-brand-bg-alt);
    padding: 1rem 1.25rem;
    border-radius: 0.5rem;
  }

  .legal-prose :global(.legal-notice p) {
    margin-bottom: 0;
    font-size: 0.875rem;
    color: var(--color-brand-text);
  }
</style>
