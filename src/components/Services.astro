---
/**
 * Services grid (section 5). Cards render straight from `client.services`.
 */
import client from '../config/client.ts';
import ServiceCard from './ServiceCard.astro';

const { services } = client;
---

<section id="services" class="section-y bg-brand-bg-alt" aria-labelledby="services-heading">
  <div class="container-x">
    <div class="max-w-2xl">
      <p class="eyebrow">What We Do</p>
      <h2 id="services-heading" class="heading-section mt-3">
        Painting & Waterproofing Services
      </h2>
      <p class="lead mt-4">
        One contractor for the whole job — diagnosis, preparation, coating and
        handover.
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
  </div>
</section>
