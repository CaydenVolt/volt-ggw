---
/**
 * Reusable closing CTA band. Used at the bottom of most pages.
 *
 * Defaults come from `client.finalCta`; every piece can be overridden so a
 * page can tailor the message without a new component.
 */
import client from '../config/client.ts';
import Icon from './Icon.astro';

export interface Props {
  headline?: string;
  subtext?: string;
  buttonLabel?: string;
  /** Where the primary button goes. */
  buttonHref?: string;
  /** `alt` uses the lighter surface, for pages that end on a dark section. */
  variant?: 'primary' | 'alt';
}

const { finalCta, contact } = client;

const {
  headline = finalCta.headline,
  subtext = finalCta.subtext,
  buttonLabel = finalCta.buttonLabel,
  buttonHref = '/contact',
  variant = 'primary',
} = Astro.props;

const isAlt = variant === 'alt';
---

<section
  class:list={['py-14 md:py-20', isAlt ? 'bg-brand-secondary' : 'bg-brand-primary']}
  aria-labelledby="cta-banner-heading"
>
  <div class="container-x">
    <div class="mx-auto max-w-3xl text-center">
      <h2
        id="cta-banner-heading"
        class="text-3xl font-extrabold leading-tight tracking-tight text-white sm:text-4xl"
      >
        {headline}
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-white/75">
        {subtext}
      </p>

      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={buttonHref} class="btn btn-accent px-8 py-4 text-base">
          {buttonLabel}
        </a>
        <a
          href={contact.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline-light px-8 py-4 text-base"
        >
          <Icon name="whatsapp" size={20} />
          <span>WhatsApp Us</span>
        </a>
      </div>

      <p class="mt-6 text-sm text-white/55">
        Or call us on{' '}
        <a
          href={`tel:${contact.phoneHref}`}
          class="font-semibold text-white/85 underline underline-offset-2 hover:text-brand-accent"
        >
          {contact.phone}
        </a>
      </p>
    </div>
  </div>
</section>
