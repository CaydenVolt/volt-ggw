---
/**
 * Full-width hero with a background image and a dark overlay.
 *
 * The background uses Astro's <Image> so it gets optimised and emitted as
 * WebP at build time, then it is absolutely positioned behind the content.
 * That keeps the optimisation benefit without a CSS `background-image`
 * (which Astro cannot process).
 */
import client from '../config/client.ts';
import Icon from './Icon.astro';
import SmartImage from './SmartImage.astro';

const { hero, contact } = client;
---

<section
  id="hero"
  class="relative isolate overflow-hidden bg-brand-primary"
  aria-labelledby="hero-heading"
>
  {/* ── Background image + overlay ── */}
  <div class="absolute inset-0 -z-10">
    <SmartImage
      src={hero.image}
      alt={hero.imageAlt}
      width={1920}
      height={1080}
      loading="eager"
      fetchpriority="high"
      sizes="100vw"
      class="h-full w-full object-cover"
    />
    {/* Two-layer scrim: vertical for text legibility, flat for overall depth. */}
    <div
      class="absolute inset-0 bg-gradient-to-b from-brand-primary/95 via-brand-primary/80 to-brand-primary/95"
    >
    </div>
    <div class="absolute inset-0 bg-brand-primary/40"></div>
  </div>

  <div class="container-x">
    <div class="flex min-h-[540px] flex-col justify-center py-16 md:min-h-[640px] md:py-24">
      <div class="max-w-3xl">
        <p class="eyebrow">{client.company.division}</p>

        <h1
          id="hero-heading"
          class="mt-4 text-4xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-6xl"
        >
          {hero.headline}
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/80 sm:text-xl">
          {hero.subheadline}
        </p>

        {/* ── CTAs ── */}
        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href="#quote" class="btn btn-accent px-7 py-4 text-base">
            Get a Free Quote
          </a>
          <a
            href={contact.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline-light px-7 py-4 text-base"
          >
            <Icon name="whatsapp" size={20} />
            <span>WhatsApp Us</span>
          </a>
        </div>

        {/* ── Trust badges ── */}
        {
          hero.badges.length > 0 && (
            <ul
              class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-white/15 pt-6"
              aria-label="Credentials"
            >
              {hero.badges.map((badge) => (
                <li class="flex items-center gap-2 text-sm font-medium text-white/85">
                  <Icon
                    name="badge-check"
                    size={18}
                    class="shrink-0 text-brand-accent"
                  />
                  <span>{badge}</span>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </div>
</section>
