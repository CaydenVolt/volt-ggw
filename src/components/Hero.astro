---
/**
 * Homepage hero — split layout.
 *
 * Left column:  location badge · headline · service line · description ·
 *               two CTAs · trust badge row
 * Right column: the estimate form card (the primary conversion point)
 *
 * On mobile the form card stacks BELOW the hero copy, so the headline and
 * CTAs still own the first screen and the form is one short scroll away.
 *
 * NOTE ON THE REFERENCE SITE
 * sergeantpainters.com currently uses a single-column centred hero with its
 * form further down the page. This split layout follows the written brief,
 * which asks for the form above the fold as the primary conversion point.
 */
import client from '../config/client.ts';
import Icon from './Icon.astro';
import SmartImage from './SmartImage.astro';
import EstimateForm from './EstimateForm.astro';

const { hero, contact, logo } = client;
---

<section class="relative isolate overflow-hidden bg-brand-primary" aria-labelledby="hero-heading">
  {/* ── Background image + scrim ── */}
  <div class="absolute inset-0 -z-10">
    <SmartImage
      src={hero.backgroundImage}
      alt={hero.backgroundImageAlt}
      width={1920}
      height={1080}
      loading="eager"
      fetchpriority="high"
      sizes="100vw"
      class="h-full w-full object-cover opacity-30"
    />
    <div class="absolute inset-0 bg-gradient-to-br from-brand-primary via-brand-primary/95 to-brand-primary/80"></div>
  </div>

  <div class="container-x">
    <div class="grid items-center gap-10 py-12 md:py-16 lg:grid-cols-[1.05fr_minmax(380px,420px)] lg:gap-12 lg:py-20">
      {/* ─────────────── Left: copy ─────────────── */}
      <div>
        {/* Logo */}
        <img
          src={logo.src}
          alt={logo.alt}
          height={logo.height}
          width={logo.height * 4}
          class="w-auto"
          style={`height:${logo.height + 10}px`}
        />

        {/* Location / credential badge */}
        {
          hero.locationBadge && (
            <p class="mt-6 inline-flex items-center gap-2 rounded-full border border-brand-accent/40 bg-brand-accent/10 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-brand-accent sm:text-sm">
              <Icon name="badge-check" size={16} class="shrink-0" />
              {hero.locationBadge}
            </p>
          )
        }

        <h1
          id="hero-heading"
          class="mt-5 text-4xl font-extrabold leading-[1.06] tracking-tight text-white sm:text-5xl xl:text-6xl"
        >
          {hero.heroHeadline}
          {
            hero.heroHeadlineAccent && (
              <>
                {' '}
                <span class="text-brand-accent">{hero.heroHeadlineAccent}</span>
              </>
            )
          }
        </h1>

        {/* Capability line */}
        {
          hero.serviceLine && (
            <p class="mt-5 border-l-4 border-brand-accent pl-4 text-base font-semibold text-white/90 sm:text-lg">
              {hero.serviceLine}
            </p>
          )
        }

        <p class="mt-5 max-w-xl text-base leading-relaxed text-white/70 sm:text-lg">
          {hero.heroSubheadline}
        </p>

        {/* ── CTAs ── */}
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href="#estimate" class="btn btn-accent px-7 py-4 text-base lg:hidden">
            Get a Free Estimate
          </a>
          <a href="/contact" class="btn btn-accent hidden px-7 py-4 text-base lg:inline-flex">
            Get a Free Estimate
          </a>
          <a
            href={contact.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline-light px-7 py-4 text-base"
          >
            <Icon name="whatsapp" size={20} />
            <span>WhatsApp Us</span>
          </a>
        </div>

        {/* ── Trust badges ── */}
        {
          hero.badges.length > 0 && (
            <ul
              class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-white/15 pt-6"
              aria-label="Credentials"
            >
              {hero.badges.map((badge) => (
                <li class="flex items-center gap-2 text-sm font-medium text-white/85">
                  <Icon name="badge-check" size={18} class="shrink-0 text-brand-accent" />
                  <span>{badge}</span>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {/* ─────────────── Right: estimate form ─────────────── */}
      <div id="estimate" class="scroll-mt-24 lg:justify-self-end lg:self-start">
        <EstimateForm variant="card" />
      </div>
    </div>
  </div>
</section>
