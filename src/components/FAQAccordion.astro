---
/**
 * Reusable FAQ accordion.
 *
 * Built on native <details>/<summary>: correct expand/collapse semantics,
 * keyboard support and screen-reader announcements for free, zero JavaScript.
 *
 * The shared `name` makes them behave as an exclusive accordion in browsers
 * that support it, and as independent toggles elsewhere. Pass a unique
 * `groupName` when two accordions appear on the same page, or they will fight.
 */
import type { FaqItem } from '../config/client.ts';
import Icon from './Icon.astro';

export interface Props {
  items: readonly FaqItem[];
  heading?: string;
  eyebrow?: string;
  /** Must be unique per accordion on a page. */
  groupName?: string;
  /** Background band. `plain` renders no section background. */
  variant?: 'alt' | 'white' | 'plain';
  /** Show the "still have a question" footer line. */
  showFooterLink?: boolean;
}

const {
  items,
  heading,
  eyebrow = 'Questions',
  groupName = 'faq',
  variant = 'alt',
  showFooterLink = true,
} = Astro.props;

const bg =
  variant === 'alt' ? 'bg-brand-bg-alt' : variant === 'white' ? 'bg-white' : '';

/* Cards need to contrast with whatever band they sit on. */
const cardBg = variant === 'white' ? 'bg-brand-bg-alt' : 'bg-white';

const headingId = `faq-heading-${groupName}`;
---

<section
  class:list={[variant === 'plain' ? '' : 'section-y', bg]}
  aria-labelledby={heading ? headingId : undefined}
>
  <div class={variant === 'plain' ? '' : 'container-x'}>
    <div class="mx-auto max-w-3xl">
      {
        heading && (
          <div class="text-center">
            {eyebrow && <p class="eyebrow">{eyebrow}</p>}
            <h2 id={headingId} class="heading-section mt-3">
              {heading}
            </h2>
          </div>
        )
      }

      <div class:list={['space-y-3', heading && 'mt-10']}>
        {
          items.map((item) => (
            <details
              name={groupName}
              class:list={[
                'group overflow-hidden rounded-xl shadow-sm ring-1 ring-slate-900/5 [&_summary::-webkit-details-marker]:hidden',
                cardBg,
              ]}
            >
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-left font-bold text-brand-primary transition-colors hover:bg-slate-500/5">
                <span class="text-[15px] leading-snug sm:text-base">
                  {item.question}
                </span>
                <span
                  class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-primary/5 text-brand-primary transition-transform duration-200 group-open:rotate-180"
                  aria-hidden="true"
                >
                  <Icon name="chevron-down" size={18} />
                </span>
              </summary>

              <div class="border-t border-slate-200 px-5 pb-5 pt-4">
                <p class="text-[15px] leading-relaxed text-brand-muted">
                  {item.answer}
                </p>
              </div>
            </details>
          ))
        }
      </div>

      {
        showFooterLink && (
          <p class="mt-8 text-center text-[15px] text-brand-muted">
            Still have a question?{' '}
            <a
              href="/contact"
              class="font-bold text-brand-primary underline underline-offset-2 hover:text-brand-accent-hover"
            >
              Ask us directly
            </a>{' '}
            — we will get back to you within one business day.
          </p>
        )
      }
    </div>
  </div>
</section>
