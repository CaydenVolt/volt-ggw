---
/**
 * Inline SVG icon set. Zero runtime, zero network requests.
 *
 * Content icons (referenced by `icon:` fields in client.ts) are stroke-based.
 * Brand glyphs (facebook, instagram, whatsapp…) are fill-based.
 *
 * To add an icon: drop a 24×24 path into STROKE_ICONS or FILL_ICONS below,
 * then add its name to `IconName` in `src/config/client.ts` if it will be
 * selectable from the config.
 */

export interface Props {
  name: string;
  /** Rendered size in px (square). */
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = '' } = Astro.props;

