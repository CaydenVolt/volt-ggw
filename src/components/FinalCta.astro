---
/**
 * Closing CTA banner (section 12).
 */
import client from '../config/client.ts';
import Icon from './Icon.astro';

const { finalCta, contact } = client;
---

<section class="bg-brand-primary py-14 md:py-20" aria-labelledby="final-cta-heading">
  <div class="container-x">
    <div class="mx-auto max-w-3xl text-center">
      <h2
        id="final-cta-heading"
        class="text-3xl font-extrabold leading-tight tracking-tight text-white sm:text-4xl"
      >
        {finalCta.headline}
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-white/75">
        {finalCta.subtext}
      </p>

      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="#quote" class="btn btn-accent px-8 py-4 text-base">
          {finalCta.buttonLabel}
        </a>
        <a
          href={contact.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline-light px-8 py-4 text-base"
        >
          <Icon name="whatsapp" size={20} />
          <span>WhatsApp Us</span>
        </a>
      </div>

      <p class="mt-6 text-sm text-white/55">
        Or call us on{' '}
        <a
          href={`tel:${contact.phoneHref}`}
          class="font-semibold text-white/85 underline underline-offset-2 hover:text-brand-accent"
        >
          {contact.phone}
        </a>
      </p>
    </div>
  </div>
</section>
