---
/**
 * Inline lead-capture form (section 3).
 *
 * CURRENT STATE — demo mode.
 * `client.form.endpoint` is an empty string, so submitting logs the payload to
 * the console and shows the success message without any network request.
 * Set that field to a real URL and the same handler POSTs JSON to it instead.
 * No other change required.
 *
 * ATTRIBUTION
 * Seven hidden fields are populated on load: the five standard UTM params from
 * the query string, plus `page_url` and `referrer`. They ride along with the
 * payload so the CRM can attribute the lead to its source.
 */
import client from '../config/client.ts';
import Icon from './Icon.astro';

const { form, company } = client;

/* `{company}` is the one token the consent string supports. */
const consentText = form.consentText.replace('{company}', company.name);

const UTM_FIELDS = [
  'utm_source',
  'utm_medium',
  'utm_campaign',
  'utm_content',
  'utm_term',
] as const;

const fieldBase =
  'w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-brand-text placeholder:text-slate-400 transition-colors focus:border-brand-accent focus:outline-none focus:ring-2 focus:ring-brand-accent/40';
---

<section id="quote" class="section-y bg-brand-bg-alt" aria-labelledby="quote-heading">
  <div class="container-x">
    <div class="mx-auto max-w-3xl">
      <div class="text-center">
        <p class="eyebrow">Free, no obligation</p>
        <h2 id="quote-heading" class="heading-section mt-3">{form.heading}</h2>
        <p class="lead mx-auto mt-4 max-w-xl">{form.subheading}</p>
      </div>

      <div class="mt-10 rounded-2xl bg-white p-6 shadow-lg shadow-slate-900/5 ring-1 ring-slate-900/5 sm:p-8">
        {/* Success panel — revealed by the script, replaces the form. */}
        <div
          id="quote-success"
          hidden
          role="status"
          aria-live="polite"
          class="flex flex-col items-center gap-4 py-10 text-center"
        >
          <span class="flex h-14 w-14 items-center justify-center rounded-full bg-brand-accent text-brand-accent-text">
            <Icon name="check" size={28} />
          </span>
          <p class="text-lg font-semibold text-brand-primary">
            {form.successMessage}
          </p>
        </div>

        <form id="quote-form" novalidate>
          {/* Attribution — populated on load, never shown. */}
          {UTM_FIELDS.map((name) => <input type="hidden" name={name} value="" />)}
          <input type="hidden" name="page_url" value="" />
          <input type="hidden" name="referrer" value="" />

          {/*
            Honeypot. Real people never fill this in; bots usually do.
            Hidden from sight AND from screen readers, and excluded from tabbing.
          */}
          <div class="absolute left-[-9999px]" aria-hidden="true">
            <label for="company-website">Do not fill this in</label>
            <input
              type="text"
              id="company-website"
              name="company_website"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label for="fullName" class="mb-1.5 block text-sm font-semibold text-brand-primary">
                Full Name <span class="text-red-600" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="fullName"
                name="fullName"
                required
                autocomplete="name"
                placeholder="Your name"
                class={fieldBase}
                aria-describedby="fullName-error"
              />
              <p id="fullName-error" class="field-error mt-1.5 hidden text-sm text-red-600"></p>
            </div>

            <div>
              <label for="phone" class="mb-1.5 block text-sm font-semibold text-brand-primary">
                Phone <span class="text-red-600" aria-hidden="true">*</span>
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                autocomplete="tel"
                inputmode="tel"
                placeholder="+65 9123 4567"
                class={fieldBase}
                aria-describedby="phone-error"
              />
              <p id="phone-error" class="field-error mt-1.5 hidden text-sm text-red-600"></p>
            </div>

            <div>
              <label for="email" class="mb-1.5 block text-sm font-semibold text-brand-primary">
                Email <span class="text-red-600" aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                placeholder="you@example.com"
                class={fieldBase}
                aria-describedby="email-error"
              />
              <p id="email-error" class="field-error mt-1.5 hidden text-sm text-red-600"></p>
            </div>

            <div class="sm:col-span-2">
              <label for="message" class="mb-1.5 block text-sm font-semibold text-brand-primary">
                Tell us about your project
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                placeholder="Property type, rough size, and what you need done — painting, waterproofing, or a leak you want looked at."
                class={fieldBase}></textarea>
            </div>
          </div>

          {/* ── Consent ── */}
          <div class="mt-6 rounded-lg bg-brand-bg-alt p-4">
            <div class="flex gap-3">
              <input
                type="checkbox"
                id="consent"
                name="consent"
                value="yes"
                required={form.consentRequired}
                class="mt-0.5 h-5 w-5 shrink-0 cursor-pointer rounded border-slate-400 accent-brand-accent"
                aria-describedby="consent-error"
              />
              <div>
                <label for="consent" class="block cursor-pointer text-sm leading-relaxed text-brand-muted">
                  {consentText}
                  {form.consentRequired && <span class="text-red-600" aria-hidden="true"> *</span>}
                </label>
                <p class="mt-2 text-xs text-brand-muted">
                  See our{' '}
                  <a href="/privacy" class="font-semibold text-brand-primary underline underline-offset-2 hover:text-brand-accent-hover">
                    Privacy Policy
                  </a>{' '}
                  and{' '}
                  <a href="/terms" class="font-semibold text-brand-primary underline underline-offset-2 hover:text-brand-accent-hover">
                    Terms of Service
                  </a>.
                </p>
              </div>
            </div>
            <p id="consent-error" class="field-error mt-2 hidden text-sm text-red-600"></p>
          </div>

          {/* Submission-level error (network / server). */}
          <p
            id="quote-form-error"
            hidden
            role="alert"
            class="mt-4 rounded-lg bg-red-50 px-4 py-3 text-sm font-medium text-red-700"
          >
          </p>

          <button type="submit" id="quote-submit" class="btn btn-accent mt-6 w-full py-4 text-base">
            {form.submitLabel}
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ endpoint: form.endpoint }}>
  (function () {
    const form = document.getElementById('quote-form');
    const success = document.getElementById('quote-success');
    const submit = document.getElementById('quote-submit');
    const formError = document.getElementById('quote-form-error');
    if (!form || !success || !submit || !formError) return;

    /* ── Attribution: UTMs from the query string, plus page and referrer ── */
    const params = new URLSearchParams(window.location.search);
    ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach((key) => {
      const field = form.elements.namedItem(key);
      if (field) field.value = params.get(key) || '';
    });
    if (form.elements.namedItem('page_url')) {
      form.elements.namedItem('page_url').value = window.location.href;
    }
    if (form.elements.namedItem('referrer')) {
      form.elements.namedItem('referrer').value = document.referrer || '';
    }

    /* ── Validation ── */
    const showError = (name, message) => {
      const field = document.getElementById(name);
      const slot = document.getElementById(name + '-error');
      if (slot) {
        slot.textContent = message;
        slot.classList.remove('hidden');
      }
      if (field) field.setAttribute('aria-invalid', 'true');
    };

    const clearErrors = () => {
      form.querySelectorAll('.field-error').forEach((el) => {
        el.textContent = '';
        el.classList.add('hidden');
      });
      form.querySelectorAll('[aria-invalid]').forEach((el) =>
        el.removeAttribute('aria-invalid')
      );
      formError.hidden = true;
    };

    const validate = (data) => {
      let firstBad = null;

      if (!String(data.fullName || '').trim()) {
        showError('fullName', 'Please enter your name.');
        firstBad = firstBad || 'fullName';
      }
      // Deliberately permissive: international formats vary far too much to
      // pattern-match safely, so we only require a plausible number of digits.
      const digits = String(data.phone || '').replace(/\D/g, '');
      if (digits.length < 7) {
        showError('phone', 'Please enter a valid phone number.');
        firstBad = firstBad || 'phone';
      }
      if (!/^\S+@\S+\.\S+$/.test(String(data.email || ''))) {
        showError('email', 'Please enter a valid email address.');
        firstBad = firstBad || 'email';
      }
      const consent = form.elements.namedItem('consent');
      if (consent && consent.required && !consent.checked) {
        showError('consent', 'Please tick the box so we can contact you.');
        firstBad = firstBad || 'consent';
      }

      return firstBad;
    };

    /* ── Submit ── */
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();

      const data = Object.fromEntries(new FormData(form).entries());

      // Honeypot tripped — pretend it worked, drop it on the floor.
      if (data.company_website) {
        form.hidden = true;
        success.hidden = false;
        return;
      }
      delete data.company_website;

      const firstBad = validate(data);
      if (firstBad) {
        document.getElementById(firstBad)?.focus();
        return;
      }

      data.submitted_at = new Date().toISOString();

      submit.disabled = true;
      submit.textContent = 'Sending…';

      try {
        if (!endpoint) {
          // ── Demo mode ──────────────────────────────────────────────────
          // No endpoint configured. Log the exact payload that would be sent
          // so the field shape can be verified before the CRM is wired up.
          console.log('[QuoteForm] Demo mode — payload that would be sent:', data);
        } else {
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });
          if (!response.ok) throw new Error('Request failed: ' + response.status);
        }

        form.hidden = true;
        success.hidden = false;
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (error) {
        console.error('[QuoteForm] Submission failed:', error);
        formError.textContent =
          'Sorry — something went wrong sending that. Please call or WhatsApp us instead.';
        formError.hidden = false;
        submit.disabled = false;
        submit.textContent = form.dataset.submitLabel || 'Request My Free Quote';
      }
    });

    // Stash the original label so the error path can restore it.
    form.dataset.submitLabel = submit.textContent;
  })();
</script>
