---
/**
 * Standalone trust band (section 4) — the hero badges again, but as a
 * proper section with icons and supporting detail lines.
 */
import client from '../config/client.ts';
import Icon from './Icon.astro';

const { trust } = client;
---

<section class="border-y border-slate-200 bg-white py-12 md:py-14" aria-labelledby="trust-heading">
  <div class="container-x">
    <h2 id="trust-heading" class="sr-only">{trust.heading}</h2>

    <ul
      class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-3 lg:grid-cols-5"
    >
      {
        trust.points.map((point) => (
          <li class="flex flex-col items-center text-center">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-primary/5 text-brand-accent-deep">
              <Icon name={point.icon} size={24} />
            </span>
            <span class="mt-3 text-sm font-bold leading-snug text-brand-primary">
              {point.label}
            </span>
            {point.detail && (
              <span class="mt-1 text-xs leading-snug text-brand-muted">
                {point.detail}
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
