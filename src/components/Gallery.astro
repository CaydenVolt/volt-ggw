---
/**
 * Project gallery (section 8).
 *
 * Grid of images with a category chip. No lightbox — the brief marks it
 * optional for v1, and skipping it keeps the page at zero extra JS.
 */
import client from '../config/client.ts';
import SmartImage from './SmartImage.astro';

const { gallery } = client;
---

<section id="gallery" class="section-y bg-brand-bg-alt" aria-labelledby="gallery-heading">
  <div class="container-x">
    <div class="max-w-2xl">
      <p class="eyebrow">Our Work</p>
      <h2 id="gallery-heading" class="heading-section mt-3">{gallery.heading}</h2>
      <p class="lead mt-4">{gallery.subheading}</p>
    </div>

    <ul class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        gallery.items.map((item) => (
          <li class="group relative overflow-hidden rounded-xl bg-brand-primary shadow-md shadow-slate-900/5">
            <div class="aspect-square">
              <SmartImage
                src={item.image}
                alt={item.alt}
                width={900}
                height={900}
                sizes="(min-width: 1024px) 400px, (min-width: 640px) 45vw, 92vw"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
            </div>

            {/* Gradient keeps the chip and caption readable on any photo. */}
            <div
              class="pointer-events-none absolute inset-0 bg-gradient-to-t from-brand-primary/85 via-brand-primary/10 to-transparent"
              aria-hidden="true"
            />

            <span class="absolute left-4 top-4 rounded-full bg-brand-accent px-3 py-1 text-xs font-bold uppercase tracking-wide text-brand-accent-text">
              {item.category}
            </span>

            <p class="absolute bottom-4 left-4 right-4 text-sm font-semibold leading-snug text-white">
              {item.alt}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
