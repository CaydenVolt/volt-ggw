---
/**
 * Dark banner at the top of every inner page.
 *
 * Gives the whole site a consistent page-title treatment and carries the
 * breadcrumb-ish "back" affordance on deep pages.
 */
import client from '../config/client.ts';
import SmartImage from './SmartImage.astro';

export interface Props {
  title: string;
  subtitle?: string;
  /** Small uppercase label above the title. */
  eyebrow?: string;
  /** Optional back link, e.g. { href: '/resources', label: 'All guides' }. */
  backLink?: { href: string; label: string };
  /** Background image path. Defaults to the hero image. */
  image?: string;
  /**
   * How present the background image is.
   *  - `subtle` (default): a texture behind the type.
   *  - `bold`: a real photograph you are meant to see. Pairs with a heavier
   *    left-to-right scrim so white text keeps its contrast over a busy or
   *    light-coloured image.
   */
  imageEmphasis?: 'subtle' | 'bold';
}

const {
  title,
  subtitle,
  eyebrow,
  backLink,
  image = client.hero.backgroundImage,
  imageEmphasis = 'subtle',
} = Astro.props;

const isBold = imageEmphasis === 'bold';
---

<section class="relative isolate overflow-hidden bg-brand-primary">
  <div class="absolute inset-0 -z-10">
    <SmartImage
      src={image}
      alt=""
      width={1920}
      height={1080}
      loading="eager"
      sizes="100vw"
      class:list={[
        'h-full w-full object-cover',
        isBold ? 'opacity-70' : 'opacity-20',
      ]}
    />
    {
      isBold ? (
        <>
          {/* Horizontal scrim: solid behind the copy, clearing to the right. */}
          <div class="absolute inset-0 bg-gradient-to-r from-brand-primary via-brand-primary/85 to-brand-primary/30" />
          {/* Vertical lift so the nav edge and lower boundary stay defined. */}
          <div class="absolute inset-0 bg-gradient-to-b from-brand-primary/60 via-transparent to-brand-primary/70" />
        </>
      ) : (
        <div class="absolute inset-0 bg-gradient-to-br from-brand-primary via-brand-primary/95 to-brand-primary/85" />
      )
    }
  </div>

  <div class="container-x">
    <div class="max-w-3xl py-14 md:py-20">
      {
        backLink && (
          <a
            href={backLink.href}
            class="text-sm font-semibold text-brand-accent transition-colors hover:text-white"
          >
            ← {backLink.label}
          </a>
        )
      }
      {eyebrow && <p class:list={['eyebrow', backLink && 'mt-4']}>{eyebrow}</p>}
      <h1
        class:list={[
          'text-3xl font-extrabold leading-tight tracking-tight text-white sm:text-4xl lg:text-5xl',
          (eyebrow || backLink) && 'mt-3',
        ]}
      >
        {title}
      </h1>
      {
        subtitle && (
          <p class="mt-5 text-lg leading-relaxed text-white/75">{subtitle}</p>
        )
      }
      <slot />
    </div>
  </div>
</section>
