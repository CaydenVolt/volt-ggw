---
/**
 * Company timeline for the homepage.
 *
 * Vertical rail on mobile, alternating two-column layout from `lg` up, with a
 * centre line. Entries come from `client.history.milestones`; adding or
 * removing one reflows the rest.
 *
 * Zero JavaScript — the alternating layout is pure grid and the connecting
 * line is a positioned element.
 */
import client from '../config/client.ts';
import Icon from './Icon.astro';

const { history } = client;
const { milestones } = history;
---

<section id="history" class="section-y bg-brand-bg-alt" aria-labelledby="history-heading">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">{history.eyebrow}</p>
      <h2 id="history-heading" class="heading-section mt-3">{history.heading}</h2>
      <p class="lead mx-auto mt-4">{history.intro}</p>
    </div>

    <div class="relative mx-auto mt-14 max-w-4xl">
      {/*
        The rail. Sits hard left on mobile (behind the markers) and centres
        from `lg` up, where the entries alternate sides.
      */}
      <span
        class="absolute bottom-0 left-[15px] top-0 w-0.5 bg-brand-primary/15 lg:left-1/2 lg:-ml-px"
        aria-hidden="true"
      ></span>

      <ol class="space-y-10 lg:space-y-0">
        {
          milestones.map((milestone, index) => {
            const isLeft = index % 2 === 0;
            return (
              <li
                class:list={[
                  'relative pl-12 lg:grid lg:grid-cols-2 lg:items-center lg:gap-x-12 lg:pl-0',
                  index > 0 && 'lg:-mt-6',
                ]}
              >
                {/* Marker */}
                <span
                  class="absolute left-0 top-1 flex h-8 w-8 items-center justify-center rounded-full border-2 border-brand-accent bg-brand-bg-alt lg:left-1/2 lg:top-1/2 lg:-ml-4 lg:-mt-4"
                  aria-hidden="true"
                >
                  <span class="h-2.5 w-2.5 rounded-full bg-brand-accent" />
                </span>

                {/* Card. Alternates column and text alignment on desktop. */}
                <div
                  class:list={[
                    'rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-900/5 lg:my-6',
                    isLeft
                      ? 'lg:col-start-1 lg:mr-2 lg:text-right'
                      : 'lg:col-start-2 lg:ml-2',
                  ]}
                >
                  <span
                    class:list={[
                      'inline-flex items-center gap-1.5 rounded-full bg-brand-accent px-3 py-1 text-xs font-extrabold uppercase tracking-wider text-brand-accent-text',
                    ]}
                  >
                    <Icon name="clock" size={13} />
                    {milestone.year}
                  </span>

                  <h3 class="mt-3 text-lg font-bold leading-snug text-brand-primary">
                    {milestone.title}
                  </h3>
                  <p class="mt-2 text-[15px] leading-relaxed text-brand-muted">
                    {milestone.description}
                  </p>
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>

    <div class="mt-12 text-center">
      <a href="/about" class="btn btn-outline-dark px-7 py-3.5">
        More About Us
      </a>
    </div>
  </div>
</section>
