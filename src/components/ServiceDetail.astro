---
/**
 * The body of a single service page.
 *
 * Shared by `/painting/[slug]` and `/waterproofing/[slug]` so the two category
 * routes stay as thin as possible, each one only supplies `getStaticPaths`
 * and hands the service here.
 */
import PageHero from './PageHero.astro';
import Icon from './Icon.astro';
import SmartImage from './SmartImage.astro';
import EstimateForm from './EstimateForm.astro';
import TrustBar from './TrustBar.astro';
import FAQAccordion from './FAQAccordion.astro';
import ReviewCarousel from './ReviewCarousel.astro';
import ProcessSteps from './ProcessSteps.astro';
import CTABanner from './CTABanner.astro';
import type { Service } from '../config/client.ts';
import client from '../config/client.ts';

export interface Props {
  service: Service;
}

const { service } = Astro.props;
const { services, serviceCategories, contact, serviceArea } = client;

const category = serviceCategories.find((c) => c.slug === service.category)!;

/* Siblings first, they are the closest alternative, then the other hub. */
const siblings = services.filter(
  (s) => s.category === service.category && s.slug !== service.slug
);
const otherHub = serviceCategories.find((c) => c.slug !== service.category)!;

const areas = serviceArea.areas.slice(0, 10);
---

<PageHero
  eyebrow={category.eyebrow}
  title={service.h1}
  subtitle={service.shortDescription}
  image={service.image}
  backLink={{ href: `/${category.slug}`, label: `All ${category.eyebrow.toLowerCase()} services` }}
>
  <div class="mt-8 flex flex-wrap gap-3">
    <a href="#service-estimate" class="btn btn-accent px-7 py-3.5">
      Get a Free Estimate
    </a>
    <a href={`tel:${contact.phoneHref}`} class="btn btn-outline-light px-7 py-3.5">
      <Icon name="phone" size={17} />
      <span>{contact.phone}</span>
    </a>
  </div>
</PageHero>

<TrustBar />

{/* ── Detail ── */}
<section class="section-y bg-white" aria-labelledby="detail-heading">
  <div class="container-x">
    <div class="grid gap-10 lg:grid-cols-[1fr_minmax(0,400px)] lg:gap-14">
      <div>
        <span class="flex h-14 w-14 items-center justify-center rounded-xl bg-brand-accent text-brand-accent-text shadow-lg">
          <Icon name={service.icon} size={28} />
        </span>

        <h2 id="detail-heading" class="heading-section mt-5">
          What {service.name} Involves
        </h2>
        <p class="lead mt-4">{service.longDescription}</p>

        <div class="mt-8 overflow-hidden rounded-2xl shadow-lg shadow-slate-900/10">
          <SmartImage
            src={service.image}
            alt={`${service.name} in Singapore`}
            width={800}
            height={600}
            sizes="(min-width: 1024px) 720px, 92vw"
            class="h-full w-full object-cover"
          />
        </div>

        <h3 class="mt-9 text-sm font-bold uppercase tracking-wider text-brand-primary">
          What’s included
        </h3>
        <ul class="mt-3 space-y-2.5">
          {
            service.includedItems.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-accent/15 text-brand-accent-deep">
                  <Icon name="check" size={15} />
                </span>
                <span class="text-[15px] leading-relaxed text-brand-text">
                  {item}
                </span>
              </li>
            ))
          }
        </ul>

        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#service-estimate" class="btn btn-accent px-7 py-3.5">
            Get a Free Estimate
          </a>
        </div>
      </div>

      <div class="lg:sticky lg:top-24 lg:self-start">
        <EstimateForm
          variant="card"
          heading={`Free ${service.name} Estimate`}
          subheading="One business day turnaround."
          showLogo={false}
        />
      </div>
    </div>
  </div>
</section>

<ProcessSteps showCta={false} />

<FAQAccordion
  items={service.faqs}
  heading={`${service.name}: Your Questions`}
  eyebrow="Straight Answers"
  groupName={`faq-${service.slug}`}
  variant="alt"
/>

<ReviewCarousel variant="white" uid={`rev-${service.slug}`} />

{/* ── Estimate form ── */}
<section
  id="service-estimate"
  class="section-y scroll-mt-20 bg-brand-bg-alt"
  aria-labelledby="estimate-heading"
>
  <div class="container-x">
    <div class="mx-auto max-w-3xl">
      <div class="text-center">
        <p class="eyebrow">Free, no obligation</p>
        <h2 id="estimate-heading" class="heading-section mt-3">
          Get a Quote for {service.name}
        </h2>
        <p class="lead mx-auto mt-4 max-w-xl">
          Send us the property details and photos of the area. We will tell you
          what it needs and quote a fixed price.
        </p>
      </div>

      <div class="mt-10">
        <EstimateForm variant="full" heading="Request Your Estimate" subheading="" />
      </div>
    </div>
  </div>
</section>

{/* ── Cross-links ── */}
<section class="section-y bg-white" aria-labelledby="more-heading">
  <div class="container-x">
    <h2 id="more-heading" class="heading-section text-center">
      More {category.eyebrow} Services
    </h2>

    <ul class="mx-auto mt-8 grid max-w-5xl gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        siblings.map((other) => (
          <li>
            <a
              href={`/${other.category}/${other.slug}`}
              class="flex h-full items-start gap-3.5 rounded-xl bg-brand-bg-alt p-5 transition-colors hover:bg-brand-accent/10"
            >
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-accent text-brand-accent-text">
                <Icon name={other.icon} size={20} />
              </span>
              <span>
                <span class="block text-[15px] font-bold leading-snug text-brand-primary">
                  {other.name}
                </span>
                <span class="mt-1 block text-sm leading-relaxed text-brand-muted">
                  {other.shortDescription}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 text-center text-[15px] text-brand-muted">
      Also need {otherHub.eyebrow.toLowerCase()}?{' '}
      <a
        href={`/${otherHub.slug}`}
        class="font-bold text-brand-primary underline underline-offset-2 hover:text-brand-accent-hover"
      >
        See our {otherHub.eyebrow.toLowerCase()} services
      </a>, combining related works avoids paying to mobilise twice.
    </p>

    <div class="mx-auto mt-12 max-w-4xl text-center">
      <h3 class="text-sm font-bold uppercase tracking-wider text-brand-primary">
        {service.name} across Singapore
      </h3>
      <ul class="mt-4 flex flex-wrap justify-center gap-2.5">
        {
          areas.map((area) => (
            <li>
              <a
                href={`/areas/${area.slug}`}
                class="block rounded-full border border-slate-200 bg-brand-bg-alt px-4 py-2 text-sm font-medium text-brand-text transition-colors hover:border-brand-accent hover:bg-brand-accent/10"
              >
                {area.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<CTABanner headline={`Need ${service.name} in Singapore?`} />
