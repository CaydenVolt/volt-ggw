---
/**
 * The child-service card grid shown on a category hub page.
 */
import Icon from './Icon.astro';
import SmartImage from './SmartImage.astro';
import client from '../config/client.ts';
import type { ServiceCategorySlug } from '../config/client.ts';

export interface Props {
  category: ServiceCategorySlug;
  heading?: string;
  intro?: string;
  variant?: 'white' | 'alt';
}

const { category, heading = 'What We Do', intro, variant = 'white' } = Astro.props;

const services = client.services.filter((s) => s.category === category);
---

<section
  id="services"
  class:list={['section-y scroll-mt-20', variant === 'white' ? 'bg-white' : 'bg-brand-bg-alt']}
  aria-labelledby="hub-services-heading"
>
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">Services</p>
      <h2 id="hub-services-heading" class="heading-section mt-3">{heading}</h2>
      {intro && <p class="lead mx-auto mt-4">{intro}</p>}
    </div>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <li class="group relative flex flex-col overflow-hidden rounded-2xl bg-white shadow-md shadow-slate-900/5 ring-1 ring-slate-900/5 transition-shadow duration-200 hover:shadow-xl hover:shadow-slate-900/10">
            <div class="relative aspect-[4/3] overflow-hidden bg-brand-primary">
              <SmartImage
                src={service.image}
                alt={service.name}
                width={800}
                height={600}
                sizes="(min-width: 1024px) 384px, (min-width: 640px) 45vw, 90vw"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
              <span class="absolute bottom-0 left-5 flex h-12 w-12 translate-y-1/2 items-center justify-center rounded-xl bg-brand-accent text-brand-accent-text shadow-lg">
                <Icon name={service.icon} size={24} />
              </span>
            </div>

            <div class="flex flex-1 flex-col p-6 pt-9">
              <h3 class="text-lg font-bold leading-snug text-brand-primary">
                {service.name}
              </h3>
              <p class="mt-2 flex-1 text-[15px] leading-relaxed text-brand-muted">
                {service.shortDescription}
              </p>

              <p class="mt-4 flex items-center gap-1.5 text-sm font-bold text-brand-primary transition-colors group-hover:text-brand-accent-deep">
                {/* Stretched link: whole card is clickable, one link in the a11y tree. */}
                <a href={`/${service.category}/${service.slug}`} class="after:absolute after:inset-0">
                  {service.name} in Singapore
                </a>
                <Icon
                  name="arrow-right"
                  size={16}
                  class="transition-transform duration-200 group-hover:translate-x-1"
                />
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
