---
/**
 * /resources — article listing.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import SmartImage from '../../components/SmartImage.astro';
import CTABanner from '../../components/CTABanner.astro';
import { articlesByDate } from '../../data/articles.ts';

const dateFormat = new Intl.DateTimeFormat('en-SG', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<BaseLayout pageKey="resources">
  <PageHero
    eyebrow="Resource Centre"
    title="Guides & Advice"
    subtitle="Practical, non-salesy answers to the questions we get asked on site. Written for Singapore properties and Singapore weather."
  />

  <section class="section-y bg-white" aria-labelledby="articles-heading">
    <div class="container-x">
      <h2 id="articles-heading" class="sr-only">Articles</h2>

      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          articlesByDate.map((article) => (
            <li class="group relative flex flex-col overflow-hidden rounded-2xl bg-white shadow-md shadow-slate-900/5 ring-1 ring-slate-900/5 transition-shadow duration-200 hover:shadow-xl hover:shadow-slate-900/10">
              <div class="aspect-[16/9] overflow-hidden bg-brand-primary">
                <SmartImage
                  src={article.image}
                  alt=""
                  width={1200}
                  height={675}
                  sizes="(min-width: 1024px) 384px, (min-width: 640px) 45vw, 90vw"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>

              <div class="flex flex-1 flex-col p-6">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs">
                  <span class="rounded-full bg-brand-accent/15 px-2.5 py-1 font-bold uppercase tracking-wide text-brand-accent-hover">
                    {article.category}
                  </span>
                  <span class="text-brand-muted">{article.readTime}</span>
                </div>

                <h3 class="mt-3 text-lg font-bold leading-snug text-brand-primary">
                  {article.title}
                </h3>

                <p class="mt-2 flex-1 text-[15px] leading-relaxed text-brand-muted">
                  {article.excerpt}
                </p>

                <div class="mt-4 flex items-center justify-between gap-3 border-t border-slate-100 pt-4">
                  <span class="text-xs text-brand-muted">
                    {dateFormat.format(new Date(article.publishedAt))}
                  </span>
                  <a
                    href={`/resources/${article.slug}`}
                    class="inline-flex items-center gap-1.5 text-sm font-bold text-brand-primary transition-colors hover:text-brand-accent-hover"
                  >
                    {/* Stretches the hit area to the whole card. */}
                    <span class="absolute inset-0" aria-hidden="true" />
                    <span>Read the guide</span>
                    <Icon
                      name="arrow-right"
                      size={16}
                      class="transition-transform duration-200 group-hover:translate-x-1"
                    />
                    <span class="sr-only">: {article.title}</span>
                  </a>
                </div>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="mt-10 text-center text-[15px] text-brand-muted">
        Got a question we have not covered?{' '}
        <a
          href="/contact"
          class="font-bold text-brand-primary underline underline-offset-2 hover:text-brand-accent-hover"
        >
          Ask us directly
        </a>.
      </p>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
