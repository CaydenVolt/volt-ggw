---
/**
 * /contact, full-width estimate form, contact details, hours, map slot.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import EstimateForm from '../components/EstimateForm.astro';
import TrustBar from '../components/TrustBar.astro';
import client from '../config/client.ts';
import Schema from '../components/Schema.astro';

const { contact, company, social } = client;

const address = [
  contact.address.line1,
  contact.address.line2,
  [contact.address.city, contact.address.postalCode].filter(Boolean).join(' '),
].filter(Boolean);
---

<BaseLayout pageKey="contact">
  <Schema slot="head" />
  <PageHero
    eyebrow="Get In Touch"
    title="Request a Free Painting or Waterproofing Estimate"
    subtitle="Tell us what you need done and we will come back to you within one business day. Site assessments are free and carry no obligation."
  />

  <section class="section-y bg-white" aria-labelledby="contact-heading">
    <div class="container-x">
      <h2 id="contact-heading" class="sr-only">Contact details and estimate form</h2>

      <div class="grid gap-10 lg:grid-cols-[1fr_minmax(0,480px)] lg:gap-14">
        {/* ─────────── Left: details ─────────── */}
        <div>
          <h3 class="heading-section">Talk to Us Directly</h3>
          <p class="lead mt-4">
            Prefer to speak to someone? Call or WhatsApp during business hours
            and you will get a person, not a queue.
          </p>

          <ul class="mt-8 space-y-4">
            <li>
              <a
                href={`tel:${contact.phoneHref}`}
                class="flex items-start gap-4 rounded-xl bg-brand-bg-alt p-5 transition-colors hover:bg-brand-accent/10"
              >
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-accent text-brand-accent-text">
                  <Icon name="phone" size={22} />
                </span>
                <span>
                  <span class="block text-sm font-bold uppercase tracking-wider text-brand-muted">
                    Phone
                  </span>
                  <span class="mt-0.5 block text-lg font-bold text-brand-primary">
                    {contact.phone}
                  </span>
                </span>
              </a>
            </li>

            <li>
              <a
                href={contact.whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-start gap-4 rounded-xl bg-brand-bg-alt p-5 transition-colors hover:bg-brand-accent/10"
              >
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-accent text-brand-accent-text">
                  <Icon name="whatsapp" size={22} />
                </span>
                <span>
                  <span class="block text-sm font-bold uppercase tracking-wider text-brand-muted">
                    WhatsApp
                  </span>
                  <span class="mt-0.5 block text-lg font-bold text-brand-primary">
                    Message us
                  </span>
                </span>
              </a>
            </li>

            <li>
              <a
                href={`mailto:${contact.email}`}
                class="flex items-start gap-4 rounded-xl bg-brand-bg-alt p-5 transition-colors hover:bg-brand-accent/10"
              >
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-accent text-brand-accent-text">
                  <Icon name="mail" size={22} />
                </span>
                <span class="min-w-0">
                  <span class="block text-sm font-bold uppercase tracking-wider text-brand-muted">
                    Email
                  </span>
                  <span class="mt-0.5 block break-all text-lg font-bold text-brand-primary">
                    {contact.email}
                  </span>
                </span>
              </a>
            </li>

            <li class="flex items-start gap-4 rounded-xl bg-brand-bg-alt p-5">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-accent text-brand-accent-text">
                <Icon name="map-pin" size={22} />
              </span>
              <span>
                <span class="block text-sm font-bold uppercase tracking-wider text-brand-muted">
                  Address
                </span>
                <address class="mt-0.5 not-italic text-[15px] font-semibold leading-relaxed text-brand-primary">
                  {address.map((line) => <span class="block">{line}</span>)}
                </address>
              </span>
            </li>
          </ul>

          {/* ── Hours ── */}
          <div class="mt-8 rounded-xl border border-slate-200 p-6">
            <h4 class="flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-brand-primary">
              <Icon name="clock" size={18} class="text-brand-accent-deep" />
              Business Hours
            </h4>
            <dl class="mt-4 space-y-2.5">
              {
                contact.hours.map((entry) => (
                  <div class="flex flex-wrap justify-between gap-x-6 gap-y-1 border-b border-slate-100 pb-2.5 last:border-0 last:pb-0">
                    <dt class="text-[15px] text-brand-muted">{entry.days}</dt>
                    <dd class="text-[15px] font-semibold text-brand-text">
                      {entry.hours}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>

          {
            social.length > 0 && (
              <div class="mt-8">
                <h4 class="text-sm font-bold uppercase tracking-wider text-brand-primary">
                  Follow Us
                </h4>
                <ul class="mt-3 flex gap-3">
                  {social.map((item) => (
                    <li>
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-primary text-white transition-colors hover:bg-brand-accent hover:text-brand-accent-text"
                      >
                        <Icon name={item.platform} size={20} />
                        <span class="sr-only">
                          {company.name} on {item.platform}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>

        {/* ─────────── Right: form ─────────── */}
        <div class="lg:sticky lg:top-24 lg:self-start">
          <EstimateForm variant="full" />
        </div>
      </div>
    </div>
  </section>

  {/* ── Map slot ── */}
  <section class="section-y bg-brand-bg-alt" aria-labelledby="map-heading">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Find Us</p>
        <h2 id="map-heading" class="heading-section mt-3">Our Location</h2>
        <p class="lead mt-4">{address.join(', ')}</p>
      </div>

      {/*
        Google Maps embed. Query string is built from `contact.address` in
        the config, so editing the address there also moves the pin here.
        `loading="lazy"` keeps the map out of the critical path, it only
        loads when the section scrolls into view.
      */}
      <div class="mt-10 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <iframe
          title={`Map showing the location of ${company.name}, ${address.join(', ')}`}
          src={`https://www.google.com/maps?q=${encodeURIComponent(address.join(', '))}&output=embed`}
          class="block aspect-[21/9] w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>

      <p class="mt-4 text-center text-sm">
        <a
          href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address.join(', '))}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-semibold text-brand-primary underline underline-offset-2 hover:text-brand-accent-hover"
        >
          <Icon name="map-pin" size={16} />
          Open in Google Maps for directions
        </a>
      </p>
    </div>
  </section>

  <TrustBar />
</BaseLayout>
