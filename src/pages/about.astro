---
/**
 * /about, company story, values, differentiators, reviews, CTA.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import SmartImage from '../components/SmartImage.astro';
import TrustBar from '../components/TrustBar.astro';
import ReviewCarousel from '../components/ReviewCarousel.astro';
import CTABanner from '../components/CTABanner.astro';
import client from '../config/client.ts';
import Schema from '../components/Schema.astro';

const { about, company } = client;
const yearsInBusiness = new Date().getFullYear() - company.foundedYear;
---

<BaseLayout pageKey="about">
  <Schema slot="head" />
  <PageHero
    eyebrow="About Us"
    title={about.heading}
    subtitle={company.tagline}
  />

  <TrustBar />

  {/* ── Story ── */}
  <section class="section-y bg-white" aria-labelledby="story-heading">
    <div class="container-x">
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="relative order-first lg:order-last">
          <div class="overflow-hidden rounded-2xl shadow-xl shadow-slate-900/10">
            <SmartImage
              src={about.image}
              alt={about.imageAlt}
              width={1000}
              height={750}
              sizes="(min-width: 1024px) 560px, 92vw"
              class="h-full w-full object-cover"
            />
          </div>

          {
            yearsInBusiness > 0 && (
              <div class="absolute -bottom-5 left-5 rounded-xl bg-brand-accent px-5 py-3 shadow-lg sm:left-8">
                <p class="text-2xl font-extrabold leading-none text-brand-accent-text">
                  {yearsInBusiness}+
                </p>
                <p class="mt-1 text-xs font-bold uppercase tracking-wider text-brand-accent-text/80">
                  Years in Singapore
                </p>
              </div>
            )
          }
        </div>

        <div>
          <p class="eyebrow">Our Story</p>
          <h2 id="story-heading" class="heading-section mt-3">
            Built on Doing It Properly
          </h2>
          <div class="mt-5 space-y-4">
            {about.story.map((paragraph) => <p class="lead">{paragraph}</p>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── Values ── */}
  <section class="section-y bg-brand-primary" aria-labelledby="values-heading">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow eyebrow-light">What We Stand For</p>
        <h2 id="values-heading" class="heading-section mt-3 text-white">
          Our Mission & Values
        </h2>
      </div>

      <ul class="mt-12 grid gap-6 sm:grid-cols-2">
        {
          about.values.map((value) => (
            <li class="rounded-2xl border border-white/10 bg-white/5 p-7">
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-accent text-brand-accent-text">
                <Icon name={value.icon} size={24} />
              </span>
              <h3 class="mt-5 text-lg font-bold text-white">{value.title}</h3>
              <p class="mt-2.5 text-[15px] leading-relaxed text-white/65">
                {value.description}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── Differentiators ── */}
  <section class="section-y bg-brand-bg-alt" aria-labelledby="why-heading">
    <div class="container-x">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Why Choose Us</p>
        <h2 id="why-heading" class="heading-section mt-3">
          What Makes Us Different
        </h2>
        <p class="lead mx-auto mt-4 max-w-xl">
          Most of these cost us money in the short term. That is rather the
          point.
        </p>
      </div>

      <ul class="mx-auto mt-10 grid max-w-4xl gap-4 sm:grid-cols-2">
        {
          about.points.map((point) => (
            <li class="flex items-start gap-3.5 rounded-xl bg-white p-5 shadow-sm ring-1 ring-slate-900/5">
              <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-accent/15 text-brand-accent-deep">
                <Icon name="check" size={16} />
              </span>
              <span class="text-[15px] font-medium leading-relaxed text-brand-text">
                {point}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ReviewCarousel variant="white" uid="about-reviews" />

  <CTABanner
    headline="Work With a Contractor Who Answers For Their Own Work"
    subtext="Book a free site assessment. We will inspect, advise and quote, with no obligation to proceed."
  />
</BaseLayout>
