---
/**
 * /services — one anchored section per service, deep-linkable as
 * `/services#<slug>` from the nav, homepage cards and footer.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import SmartImage from '../components/SmartImage.astro';
import EstimateForm from '../components/EstimateForm.astro';
import TrustBar from '../components/TrustBar.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CTABanner from '../components/CTABanner.astro';
import client from '../config/client.ts';

const { services } = client;
---

<BaseLayout pageKey="services">
  <PageHero
    eyebrow="What We Do"
    title="Our Services"
    subtitle="Painting, waterproofing and the repair work that has to happen first. One contractor from diagnosis to handover."
  >
    {/* Jump links — quick access to each anchored section below. */}
    <ul class="mt-8 flex flex-wrap gap-2.5">
      {
        services.map((service) => (
          <li>
            <a
              href={`#${service.slug}`}
              class="inline-flex items-center gap-2 rounded-full border border-white/25 px-4 py-2 text-sm font-medium text-white/85 transition-colors hover:border-brand-accent hover:bg-brand-accent/15 hover:text-white"
            >
              <Icon name={service.icon} size={16} class="text-brand-accent-deep" />
              {service.name}
            </a>
          </li>
        ))
      }
    </ul>
  </PageHero>

  <TrustBar />

  {/* ── One section per service ── */}
  {
    services.map((service, index) => (
      <section
        id={service.slug}
        class:list={[
          'section-y scroll-mt-20',
          index % 2 === 0 ? 'bg-white' : 'bg-brand-bg-alt',
        ]}
        aria-labelledby={`${service.slug}-heading`}
      >
        <div class="container-x">
          <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
            {/* Image — alternates side with each section. */}
            <div class:list={[index % 2 === 1 && 'lg:order-last']}>
              <div class="overflow-hidden rounded-2xl shadow-xl shadow-slate-900/10">
                <SmartImage
                  src={service.image}
                  alt={service.name}
                  width={800}
                  height={600}
                  sizes="(min-width: 1024px) 560px, 92vw"
                  class="h-full w-full object-cover"
                />
              </div>
            </div>

            {/* Copy */}
            <div>
              <span class="flex h-14 w-14 items-center justify-center rounded-xl bg-brand-accent text-brand-accent-text shadow-lg">
                <Icon name={service.icon} size={28} />
              </span>

              <h2
                id={`${service.slug}-heading`}
                class="heading-section mt-5"
              >
                {service.name}
              </h2>

              <p class="lead mt-4">{service.longDescription}</p>

              <h3 class="mt-7 text-sm font-bold uppercase tracking-wider text-brand-primary">
                What’s included
              </h3>
              <ul class="mt-3 space-y-2.5">
                {service.includedItems.map((item) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-accent/15 text-brand-accent-deep">
                      <Icon name="check" size={15} />
                    </span>
                    <span class="text-[15px] leading-relaxed text-brand-text">
                      {item}
                    </span>
                  </li>
                ))}
              </ul>

              <div class="mt-8 flex flex-wrap gap-3">
                <a href="#services-estimate" class="btn btn-accent px-7 py-3.5">
                  Get a Free Estimate
                </a>
                <a href="/pricing" class="btn btn-outline-dark px-7 py-3.5">
                  See Pricing Guide
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <ProcessSteps showCta={false} />

  {/* ── Inline estimate form ── */}
  <section
    id="services-estimate"
    class="section-y scroll-mt-20 bg-brand-bg-alt"
    aria-labelledby="services-estimate-heading"
  >
    <div class="container-x">
      <div class="mx-auto max-w-3xl">
        <div class="text-center">
          <p class="eyebrow">Free, no obligation</p>
          <h2 id="services-estimate-heading" class="heading-section mt-3">
            Not Sure Which Service You Need?
          </h2>
          <p class="lead mx-auto mt-4 max-w-xl">
            Describe the problem and we will tell you what it actually is —
            then quote for fixing it.
          </p>
        </div>

        <div class="mt-10">
          <EstimateForm variant="full" heading="Get a Free Estimate" subheading="" />
        </div>
      </div>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
