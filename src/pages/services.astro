---
/**
 * /services — index. Each card links to that service's own page.
 *
 * This page deliberately does NOT try to rank for every individual service.
 * It ranks for the broad "painting and waterproofing services singapore" term
 * and hands the specific searches off to `/services/<slug>`, each of which has
 * its own H1, meta description and FAQ block.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import SmartImage from '../components/SmartImage.astro';
import EstimateForm from '../components/EstimateForm.astro';
import TrustBar from '../components/TrustBar.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CTABanner from '../components/CTABanner.astro';
import Schema from '../components/Schema.astro';
import client from '../config/client.ts';

const { services, waterproofingProducts } = client;
---

<BaseLayout pageKey="services">
  <Schema slot="head" />

  <PageHero
    eyebrow="What We Do"
    title="Painting & Waterproofing Services in Singapore"
    subtitle="Six services, one contractor — from diagnosing why a wall failed through to the final coat. HDB, condominium, landed and commercial."
  />

  <TrustBar />

  {/* ── Service cards ── */}
  <section class="section-y bg-white" aria-labelledby="services-heading">
    <div class="container-x">
      <h2 id="services-heading" class="sr-only">Our services</h2>

      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service) => (
            <li class="group relative flex flex-col overflow-hidden rounded-2xl bg-white shadow-md shadow-slate-900/5 ring-1 ring-slate-900/5 transition-shadow duration-200 hover:shadow-xl hover:shadow-slate-900/10">
              <div class="relative aspect-[4/3] overflow-hidden bg-brand-primary">
                <SmartImage
                  src={service.image}
                  alt={service.name}
                  width={800}
                  height={600}
                  sizes="(min-width: 1024px) 384px, (min-width: 640px) 45vw, 90vw"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
                <span class="absolute bottom-0 left-5 flex h-12 w-12 translate-y-1/2 items-center justify-center rounded-xl bg-brand-accent text-brand-accent-text shadow-lg">
                  <Icon name={service.icon} size={24} />
                </span>
              </div>

              <div class="flex flex-1 flex-col p-6 pt-9">
                <h3 class="text-lg font-bold leading-snug text-brand-primary">
                  {service.name}
                </h3>
                <p class="mt-2 flex-1 text-[15px] leading-relaxed text-brand-muted">
                  {service.shortDescription}
                </p>

                <p class="mt-4 flex items-center gap-1.5 text-sm font-bold text-brand-primary transition-colors group-hover:text-brand-accent-deep">
                  <a href={`/services/${service.slug}`} class="after:absolute after:inset-0">
                    {service.name} in Singapore
                  </a>
                  <Icon
                    name="arrow-right"
                    size={16}
                    class="transition-transform duration-200 group-hover:translate-x-1"
                  />
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── Concrete waterproofing product range ── */}
  <section
    id="waterproofing-products"
    class="section-y scroll-mt-20 bg-brand-primary"
    aria-labelledby="wp-products-heading"
  >
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow eyebrow-light">{waterproofingProducts.eyebrow}</p>
        <h2 id="wp-products-heading" class="heading-section mt-3 text-white">
          {waterproofingProducts.heading}
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-white/70">
          {waterproofingProducts.intro}
        </p>
      </div>

      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          waterproofingProducts.items.map((product) => (
            <li class="flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/5">
              <div class="bg-white p-4">
                <SmartImage
                  src={product.image}
                  alt={`${product.code} ${product.name}`}
                  width={700}
                  height={700}
                  sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw"
                  class="mx-auto h-44 w-auto object-contain"
                />
              </div>

              <div class="flex flex-1 flex-col p-6">
                <span class="inline-flex self-start rounded-full bg-brand-accent px-3 py-1 text-xs font-extrabold uppercase tracking-wider text-brand-accent-text">
                  {product.code}
                </span>
                <h3 class="mt-3 text-lg font-bold leading-snug text-white">
                  {product.name}
                </h3>
                <p class="mt-0.5 text-sm font-semibold text-brand-accent">
                  {product.variant}
                </p>
                <p class="mt-3 flex-1 text-[15px] leading-relaxed text-white/65">
                  {product.description}
                </p>
                <p class="mt-4 border-t border-white/10 pt-3 text-sm text-white/70">
                  <span class="font-bold text-white">Packaging:</span>{' '}
                  {product.packaging}
                </p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="mt-10 text-center">
        <a href="/services/waterproofing" class="btn btn-accent px-7 py-3.5">
          More on Waterproofing
        </a>
      </div>
    </div>
  </section>

  <ProcessSteps showCta={false} />

  {/* ── Inline estimate form ── */}
  <section
    id="services-estimate"
    class="section-y scroll-mt-20 bg-brand-bg-alt"
    aria-labelledby="services-estimate-heading"
  >
    <div class="container-x">
      <div class="mx-auto max-w-3xl">
        <div class="text-center">
          <p class="eyebrow">Free, no obligation</p>
          <h2 id="services-estimate-heading" class="heading-section mt-3">
            Not Sure Which Service You Need?
          </h2>
          <p class="lead mx-auto mt-4 max-w-xl">
            Describe the problem and we will tell you what it actually is —
            then quote for fixing it.
          </p>
        </div>

        <div class="mt-10">
          <EstimateForm variant="full" heading="Get a Free Estimate" subheading="" />
        </div>
      </div>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
