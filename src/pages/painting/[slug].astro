---
/**
 * /painting/<slug> — one page per painting service.
 * Body lives in ServiceDetail so this route and the waterproofing one stay
 * identical in behaviour.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceDetail from '../../components/ServiceDetail.astro';
import Schema from '../../components/Schema.astro';
import client from '../../config/client.ts';

export const getStaticPaths = (() =>
  client.services
    .filter((service) => service.category === 'painting')
    .map((service) => ({
      params: { slug: service.slug },
      props: { service },
    }))) satisfies GetStaticPaths;

const { service } = Astro.props;
---

<BaseLayout
  title={service.metaTitle}
  description={service.metaDescription}
  ogImage={service.image}
>
  <Schema slot="head" type="service" service={service} />
  <ServiceDetail service={service} />
</BaseLayout>
