---
/**
 * Homepage. Section order follows the brief.
 * All copy comes from `src/config/client.ts`.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import client from '../config/client.ts';

import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import AboutPreview from '../components/AboutPreview.astro';
import OurHistory from '../components/OurHistory.astro';
import GalleryPreview from '../components/GalleryPreview.astro';
import ReviewCarousel from '../components/ReviewCarousel.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import ServiceArea from '../components/ServiceArea.astro';
import CTABanner from '../components/CTABanner.astro';
---

<BaseLayout pageKey="home">
  <Hero />
  <TrustBar />
  <ServicesGrid />
  <ProcessSteps />
  <AboutPreview />
  <OurHistory />
  <GalleryPreview limit={6} />
  <ReviewCarousel variant="white" />
  <FAQAccordion
    items={client.faq.items}
    heading={client.faq.heading}
    groupName="home-faq"
    variant="alt"
  />
  <ServiceArea variant="white" />
  <CTABanner />
</BaseLayout>
