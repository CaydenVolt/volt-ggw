# ─────────────────────────────────────────────────────────────────────────────
#  Environment variables — copy to `.env` and fill in.
# ─────────────────────────────────────────────────────────────────────────────
#
#  `.env` is gitignored. Never commit real tokens.
#
#  WHAT BELONGS HERE vs. IN client.ts
#  ──────────────────────────────────
#  This site is statically built, so anything referenced in a component ends up
#  readable in the page source. The split is therefore:
#
#    src/config/client.ts  → public values (phone, colours, GA4 ID, Pixel ID).
#                            These are *meant* to be public.
#
#    .env                  → secrets that must never reach the browser
#                            (API tokens, private keys, webhook signing secrets).
#
#  A secret is only actually safe here if it is used at BUILD time, or inside a
#  Cloudflare Pages Function — never in a component that renders to the client.
#
#  In Astro, only variables prefixed `PUBLIC_` are exposed to client-side code.
#  Everything below is deliberately NOT prefixed.


# ── GoHighLevel ──────────────────────────────────────────────────────────────
# Not wired up yet. The quote form currently runs in demo mode (console.log).
# When the integration is built, these get read by a Cloudflare Pages Function
# at `functions/api/lead.ts` so the token stays server-side.

GHL_API_TOKEN=
GHL_LOCATION_ID=

# The inbound webhook / form endpoint GHL gives you.
# NOTE: if this endpoint is safe to call directly from the browser, you can
# instead paste it into `client.ts` → `form.endpoint` and skip the Function.
GHL_WEBHOOK_URL=


# ── Analytics ────────────────────────────────────────────────────────────────
# These are public IDs. They live in `client.ts` → `analytics` and are the
# values the site actually uses. They are duplicated here only so a deploy
# pipeline can inject them per-environment if you prefer that over editing
# the config file. Leave blank unless you are doing that.

PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_GOOGLE_ADS_ID=


# ── Site ─────────────────────────────────────────────────────────────────────
# Overrides `client.ts` → `seo.siteUrl` for preview vs. production builds.
# Optional. No trailing slash.

PUBLIC_SITE_URL=
